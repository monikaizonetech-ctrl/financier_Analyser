# The base URL of your deployed backend API.
# Note: Since the backend serves its routes under /api/v1, make sure to include /api/v1 at the end of the URL.
# 
# Example for local development:
# VITE_API_URL=http://localhost:8000/api/v1
#
# Example for production (replace with your actual deployed URL):
# VITE_API_URL=https://my-backend-app.onrender.com/api/v1

VITE_API_URL=http://localhost:8000/api/v1
